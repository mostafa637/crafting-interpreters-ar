# Typst build outputs -------------------------------------------------------
# The generated .typ sources and the PDFs are build products: `make typst`
# (or `python3 -m tools.typstbuild`) writes them into typst/.
typst/chapters/
typst/chapters-ar/
typst/frontmatter/
typst/main.typ
typst/main-ar.typ
typst/*.pdf
# Scratch documents used while debugging the template.
typst/_*.typ
__pycache__/
*.pyc
# The venv the Typst compiler lives in, and qa_doc/probe renders.
.venv-typst/
build/
